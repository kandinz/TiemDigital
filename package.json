{
  "name": "tiemdigital",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --config wrangler.worker.jsonc",
    "build": "tsc -b && vite build && npm run build:mmo",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.worker.json && npm run typecheck:mmo",
    "test": "vitest run",
    "dev:worker": "wrangler dev --config wrangler.worker.jsonc",
    "precheck:pages": "node -e \"require('node:fs').mkdirSync('.wrangler', { recursive: true })\"",
    "check:pages": "wrangler pages functions build-env . --outfile .wrangler/pages-build-env.json && wrangler pages functions build --build-output-directory dist --outdir .wrangler/pages-build",
    "schema:local": "node scripts/schema.mjs",
    "deploy": "node scripts/deploy.mjs",
    "build:mmo": "vite build --config modules/mmo/vite.config.ts",
    "typecheck:mmo": "node scripts/typecheck-mmo.cjs --noEmit -p modules/mmo/tsconfig.json"
  },
  "dependencies": {
    "better-auth": "^1.7.14",
    "clsx": "^2.1.1",
    "hono": "^4.13.8",
    "jose": "^6.2.13",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@cloudflare/workers-types": "^5.20261028.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui-dist": "^3.30.6",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.6.2",
    "axios": "^1.20.0",
    "lucide-vue-next": "^1.0.0",
    "oxlint": "^1.89.0",
    "pinia": "^2.3.1",
    "postcss": "^8.5.32",
    "swagger-ui-dist": "^5.34.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-mmo": "npm:tailwindcss@^3.4.19",
    "typescript": "~7.0.2",
    "typescript-mmo": "npm:typescript@~6.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.154.0"
  }
}
